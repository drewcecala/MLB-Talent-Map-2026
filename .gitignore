# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/pages-dist/
/.wrangler/
/outputs/
/work/

# local research snapshots containing player-level source fields
/data/processed/

# Raw third-party source downloads (USGS GNIS, Census Gazetteer, Natural Earth,
# MLB rosters, Lahman, Chadwick). Public-domain or licensed upstream and cited
# in ATTRIBUTION.md — downloaded on demand rather than redistributed here.
# Needed only by `npm run data:build`; the derived outputs in public/data/ are
# committed, so install/build/test work from a clean clone without them.
/data/raw/
